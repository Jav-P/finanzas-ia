SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# URL del frontend, usada para armar los links de invitacion.
FRONTEND_URL=http://localhost:4210
# En local apunta a Mailpit (supabase start); en produccion, tu SMTP real (ej. Resend).
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_USER=
SMTP_PASS=

# Necesaria para /ocr/factura y /ocr/extracto (console.anthropic.com).
# Configura un limite de gasto mensual bajo (ej. $5 USD) como precaucion.
ANTHROPIC_API_KEY=
